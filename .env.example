# Nebius Token Factory (OpenAI-compatible endpoint)
# Leave the key blank for local mock mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_NANO_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-253B
MODEL_TIMEOUT_SECONDS=12

# Optional Tavily integration
TAVILY_API_KEY=

# Internal service configuration
DATABASE_PATH=/data/agentsentinel.db
SANDBOX_URL=http://sandbox:8100
FRONTEND_ORIGIN=http://localhost:3000
